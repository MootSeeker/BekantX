# Wi-Fi manager defaults
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4

# MQTT service defaults
CONFIG_MQTT_BROKER_URI_DEFAULT="mqtt://homeassistant.local"
CONFIG_MQTT_TOPIC_PREFIX="bekantx"
CONFIG_MQTT_DEVICE_ID="desk001"
CONFIG_MQTT_KEEPALIVE_SEC=60
CONFIG_MQTT_CMD_QUEUE_DEPTH=8
CONFIG_MQTT_QOS=1
CONFIG_MQTT_HA_DISCOVERY_ENABLED=y
CONFIG_MQTT_HA_DISCOVERY_PREFIX="homeassistant"
CONFIG_MQTT_NVS_NAMESPACE="mqtt_cfg"

# Deep sleep defaults
CONFIG_BEKANTX_SLEEP_ENABLED=y
CONFIG_BEKANTX_SLEEP_WAKE_GPIO=9
CONFIG_BEKANTX_SLEEP_WAKE_LEVEL=0
